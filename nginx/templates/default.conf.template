# Головний reverse-proxy MyGym з HTTPS (Let's Encrypt).
#
# Це шаблон: офіційний образ nginx при старті підставляє змінні середовища
# (${DOMAIN}) і кладе результат у /etc/nginx/conf.d/default.conf.
# Змінні самого nginx ($host, $remote_addr...) не чіпаються, бо таких
# змінних середовища в контейнері немає.

# ---------- HTTP (80): тільки перевірка Let's Encrypt + редирект ----------
server {
    listen 80;
    server_name ${DOMAIN};

    # Сюди certbot кладе одноразові файли, коли поновлює сертифікат.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        # На ${DOMAIN}, а не на $host: запит на голий IP інакше потрапив би на
        # https://<IP>, де сертифікат не збігається з адресою.
        return 301 https://${DOMAIN}$request_uri;
    }
}

# ---------- HTTPS (443) ----------
server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    # HSTS спершу на добу: якщо з сертифікатом щось піде не так, браузери
    # швидко "забудуть" примусовий HTTPS. Коли все стабільно - збільшити.
    add_header Strict-Transport-Security "max-age=86400" always;

    client_max_body_size 10m;

    # Внутрішній DNS Docker. Потрібен для /mcp нижче: адреса сервісу mcp
    # шукається під час запиту, а не при старті, тож nginx запускається
    # навіть тоді, коли контейнера mcp ще не існує (/mcp поки віддасть 502).
    resolver 127.0.0.11 valid=30s ipv6=off;

    location /api/ {
        proxy_pass http://backend:4000;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    # MCP-сервер (TASK_MCP_SERVER.md). Заголовок Authorization з токеном
    # користувача nginx передає далі без змін.
    location /mcp {
        set $mcp_upstream mcp:8080;
        proxy_pass http://$mcp_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection        "";
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        # MCP відповідає потоком - без буферизації і з довшим таймаутом
        proxy_buffering    off;
        proxy_cache        off;
        proxy_read_timeout 300s;
    }

    location / {
        proxy_pass http://frontend:80;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
