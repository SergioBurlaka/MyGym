# ==== PostgreSQL ====
POSTGRES_USER=mygym
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=mygym
POSTGRES_PORT=5432

# Used by the backend to connect to postgres (service name "postgres" inside docker network)
DATABASE_URL=postgresql://mygym:change_me_strong_password@postgres:5432/mygym

# ==== Backend ====
NODE_ENV=production
PORT=4000

# Secrets - generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret

# Token lifetimes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Comma-separated list of origins allowed to call the API directly (dev only;
# in production nginx serves both frontend and API from the same origin)
CORS_ORIGIN=http://localhost:5173

# ==== Google OAuth ("Sign in with Google") ====
# From Google Cloud Console -> Google Auth Platform -> Clients. Leave both
# empty to keep Google login off. The secret is shown only once at creation.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match one of the client's Authorized redirect URIs.
# Dev (through the Vite proxy): http://localhost:5173/api/auth/google/callback
# Prod: https://<DOMAIN>/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# ==== OAuth for MCP clients (Claude, ChatGPT sign-in) ====
# Public origin, no trailing slash. In prod docker-compose sets it to
# https://${DOMAIN} itself; this value is the dev default (Vite proxy).
PUBLIC_URL=http://localhost:5173
# Hosts allowed to sign in as OAuth clients (Client ID Metadata Documents).
OAUTH_CLIENT_HOSTS=claude.ai,claude.com,chatgpt.com

# ==== Frontend (build-time) ====
# Base path the frontend uses to call the API. In production this goes through
# nginx on the same origin, so it's just "/api".
VITE_API_URL=/api

# ==== HTTPS (DuckDNS + Let's Encrypt) ====
# Your DuckDNS subdomain pointing at the server's IP
DOMAIN=mygym.duckdns.org
# Email for Let's Encrypt (expiry warnings if renewal ever fails)
CERTBOT_EMAIL=you@example.com
