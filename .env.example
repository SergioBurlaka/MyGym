# ==== PostgreSQL ====
POSTGRES_USER=mygym
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=mygym
POSTGRES_PORT=5432

# Used by the backend to connect to postgres (service name "postgres" inside docker network)
DATABASE_URL=postgresql://mygym:change_me_strong_password@postgres:5432/mygym

# ==== Backend ====
NODE_ENV=production
PORT=4000

# Secrets - generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret

# Token lifetimes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Comma-separated list of origins allowed to call the API directly (dev only;
# in production nginx serves both frontend and API from the same origin)
CORS_ORIGIN=http://localhost:5173

# ==== Frontend (build-time) ====
# Base path the frontend uses to call the API. In production this goes through
# nginx on the same origin, so it's just "/api".
VITE_API_URL=/api

# ==== nginx ====
NGINX_PORT=80
